{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Full Stack (Docker + proxy)",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["run", "--rm", "-p", "5200:5200", "--network", "guess-who-main_default", "alpine/socat", "TCP-LISTEN:5200,fork,reuseaddr", "TCP:imposter-web-dev:5173"],
      "port": 5200
    },
    {
      "name": "Web only (Vite)",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": ["-c", "export PATH=/opt/homebrew/bin:$PATH && pnpm --filter web dev --port 5175"],
      "port": 5175,
      "autoPort": true
    },
    {
      "name": "Docker App",
      "runtimeExecutable": "/opt/homebrew/bin/node",
      "runtimeArgs": ["-e", "const net=require('net');const port=process.env.PORT||5174;net.createServer(c=>{const s=net.connect(5173,()=>{c.pipe(s);s.pipe(c)});s.on('error',()=>c.destroy());c.on('error',()=>s.destroy())}).listen(port,()=>console.log('proxy on '+port))"],
      "port": 5174,
      "autoPort": true
    },
    {
      "name": "API only (Fastify)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "api", "dev"],
      "port": 3001
    },
    {
      "name": "Prisma Studio",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "api", "db:studio"],
      "port": 5555
    }
  ]
}
