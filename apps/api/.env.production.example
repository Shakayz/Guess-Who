# ============================================================
# PRODUCTION ENVIRONMENT — copy to .env and fill all values
# NEVER commit the actual .env file
# ============================================================

NODE_ENV=production
PORT=3001

# Database (use a strong password, never the default)
# Must match POSTGRES_PASSWORD in docker-compose.prod.yml
DATABASE_URL=postgresql://postgres:STRONG_PASSWORD@postgres:5432/red_handed_prod

# Redis (set a password in production)
# Must match REDIS_PASSWORD in docker-compose.prod.yml
REDIS_PASSWORD=STRONG_REDIS_PASSWORD
REDIS_URL=redis://:STRONG_REDIS_PASSWORD@redis:6379

# JWT — MUST be at least 32 random characters
# Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Your app public URL
APP_URL=https://yourdomain.com

# Google OAuth (optional — leave empty to disable)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Apple Sign In (optional — leave empty to disable)
# APPLE_CLIENT_ID is the Services ID (not the App ID bundle) — see Apple Developer → Identifiers → Services IDs.
# Only the Services ID is needed: the popup flow sends the identityToken directly to /auth/apple/verify,
# which only checks the JWT audience — no server-to-server token exchange, so no TEAM_ID/KEY_ID/PRIVATE_KEY.
APPLE_CLIENT_ID=com.redhanded.game.signin

# Stripe (optional — leave empty to disable payments).
# Live mode in production; use sk_test_/whsec_ from a test-mode dashboard in staging.
# Create one Product + one-time Price per pack (amounts must match COIN_PACKS
# in packages/shared/src/constants — see that file for the authoritative list).
# Webhook URL on production: https://api.yourdomain.com/api/shop/webhook
# Events: checkout.session.completed, checkout.session.expired
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUCCESS_URL=https://yourdomain.com/shop?checkout=success
STRIPE_CANCEL_URL=https://yourdomain.com/shop?checkout=canceled
STRIPE_PRICE_ID_PACK_500=price_...
STRIPE_PRICE_ID_PACK_1500=price_...
STRIPE_PRICE_ID_PACK_5000=price_...
