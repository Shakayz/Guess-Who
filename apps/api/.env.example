# ── Development environment template ────────────────────────────────────────
# Copy to .env: cp apps/api/.env.example apps/api/.env
#
# When running via Docker Compose, DATABASE_URL, REDIS_URL, JWT_SECRET, and
# ALLOWED_ORIGINS are all overridden by docker-compose environment settings.
# The remaining optional vars (OAuth, SMTP, etc.) are still read from this file.
# ────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3001

# Used for local dev outside Docker. Docker Compose overrides these automatically.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/red_handed_dev
REDIS_URL=redis://localhost:6379

# REQUIRED — must be at least 32 characters.
# Generate a strong secret: openssl rand -base64 48
# Docker Compose provides a dev default, but set this for local dev.
JWT_SECRET=dev-only-secret-do-not-use-in-production-x1y2z3

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:19006

# Google OAuth (optional — leave empty to disable)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Apple Sign In (optional — leave empty to disable)
# APPLE_CLIENT_ID is the Services ID (not the App ID bundle) — see Apple Developer → Identifiers → Services IDs.
# Must match VITE_APPLE_CLIENT_ID in apps/web/.env. The popup flow sends the identityToken to
# /auth/apple/verify, which only checks the JWT audience — no TEAM_ID/KEY_ID/PRIVATE_KEY needed.
# APPLE_CLIENT_ID=com.redhanded.game.signin

# Email (optional — leave empty to disable)
# RESEND_API_KEY=re_...
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@redhanded.game
