generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique @db.VarChar(20)
  email         String   @unique
  passwordHash  String?
  googleId      String?  @unique
  appleId       String?  @unique
  discordId     String?  @unique
  avatarUrl     String?
  locale        String   @default("en") @db.VarChar(5)
  starCoins     Int      @default(20)
  rankTier      String   @default("wooden") @db.VarChar(20)
  rankPoints    Int      @default(0)
  honorPoints   Int      @default(0)
  seasonXp      Int      @default(0)
  level           Int      @default(1)
  xp              Int      @default(0)
  hasPlayedRanked Boolean  @default(false)
  tutorialCompleted Boolean @default(false)
  emailVerified            Boolean   @default(false)
  emailVerificationCode    String?   @db.VarChar(6)
  emailVerificationExpires DateTime?
  // Referral / invite system. Every account is issued its own immutable
  // `referralCode` that they can share; `referredByUserId` is set at signup
  // time when the new user submits someone else's code. The invitee is
  // credited (REFERRAL_INVITEE_REWARD) immediately at signup, but the
  // inviter is only paid (REFERRAL_INVITER_REWARD) once the invitee plays
  // their first ranked game — `referralInviterRewarded` is the idempotency
  // flag that prevents double-crediting.
  referralCode            String? @unique @db.VarChar(12)
  referredByUserId        String?
  referredBy              User?   @relation("Referrals", fields: [referredByUserId], references: [id])
  referred                User[]  @relation("Referrals")
  referralInviterRewarded Boolean @default(false)
  // One-time "share the app on social media" reward. SOCIAL_SHARE_REWARD stars
  // are credited the first time the user taps the Share & Earn button in
  // ReferralCard. The claim endpoint flips this column from NULL to the claim
  // timestamp via an atomic updateMany guard (WHERE sharedAppAt IS NULL) so
  // concurrent calls can't double-credit. External shares can't be verified,
  // so it's trust-on-click — capped at once per account.
  sharedAppAt             DateTime?
  pushToken     String?
  lastPlayedAt     DateTime?
  dailyStreakCount Int       @default(0)
  // ── Premium subscription ────────────────────────────────────────────────────
  // `premiumUntil` is the single source of truth: a user is premium iff this
  // column is non-null and strictly in the future. The webhook writes
  // `current_period_end` here on every Stripe subscription event, so a
  // cancelled sub keeps its perks until the paid period actually ends.
  // `stripeCustomerId` is created the first time a user starts a subscription
  // checkout and reused across renewals so returning customers see saved cards
  // and a single billing history. `stripeSubscriptionId` lets the webhook and
  // billing-portal route look up the live subscription without scanning.
  premiumUntil         DateTime?
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rooms               Room[]
  gameParticipations  GameParticipation[]
  sentHonors          Honor[]             @relation("sender")
  receivedHonors      Honor[]             @relation("receiver")
  achievements        UserAchievement[]
  sentFriendRequests     Friendship[]    @relation("SentRequests")
  receivedFriendRequests Friendship[]    @relation("ReceivedRequests")
  sentDMs                DirectMessage[] @relation("SentDMs")
  receivedDMs            DirectMessage[] @relation("ReceivedDMs")
  sentGifts              Gift[]          @relation("GiftSender")
  receivedGifts          Gift[]          @relation("GiftReceiver")
  seasonPassClaims       SeasonPassClaim[]
  purchases              Purchase[]
  blocksGiven            Block[]         @relation("blocker")
  blocksReceived         Block[]         @relation("blocked")
  reportsMade            Report[]        @relation("reporter")
  reportsReceived        Report[]        @relation("reported")

  @@index([rankPoints(sort: Desc)])
  @@map("users")
}

model Room {
  id                  String   @id @default(cuid())
  code                String   @unique @db.VarChar(10)
  hostId              String
  status              String   @default("waiting") @db.VarChar(20)
  maxPlayers          Int      @default(10)
  redHandedCount       Int      @default(2)
  speakingTimeSeconds Int      @default(30)
  votingTimeSeconds   Int      @default(30)
  wordPackId          String   @default("default")
  isPrivate           Boolean  @default(false)
  // Discoverability flag for Custom Lobbies: when true, the lobby is surfaced
  // in the "Join Public Lobby" browser. Pricing is unaffected — a public
  // Custom Lobby still has isPrivate=true (the host pays the commitment fee
  // and per-game fees, players play free). Only ranked matchmaking rooms set
  // isPrivate=false, which keeps the host-vs-player charging logic untouched.
  isPublic            Boolean  @default(false)
  language            String   @default("en") @db.VarChar(5)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  host  User   @relation(fields: [hostId], references: [id])
  games Game[]

  @@index([isPublic, status])
  @@map("rooms")
}

model Game {
  id         String   @id @default(cuid())
  roomId     String
  winnerId   String?
  winnerTeam String?  @db.VarChar(20)
  // 'normal' | 'special' | 'ranked' — set at game creation from the live
  // room state so historical stats can be filtered ranked vs unranked.
  gameMode   String   @default("normal") @db.VarChar(20)
  startedAt  DateTime @default(now())
  endedAt    DateTime?

  room          Room                @relation(fields: [roomId], references: [id])
  rounds        Round[]
  participations GameParticipation[]
  chatMessages  GameChatMessage[]

  @@index([roomId, startedAt(sort: Desc)])
  @@map("games")
}

model Round {
  id              String   @id @default(cuid())
  gameId          String
  roundNumber     Int
  villagerWord    String
  redHandedWord    String
  eliminatedId    String?
  eliminatedRole  String?
  createdAt       DateTime @default(now())

  game    Game     @relation(fields: [gameId], references: [id])
  votes   RoundVote[]
  clues   RoundClue[]

  @@index([gameId])
  @@map("rounds")
}

model RoundVote {
  id        String   @id @default(cuid())
  roundId   String
  voterId   String
  targetId  String
  createdAt DateTime @default(now())

  round Round @relation(fields: [roundId], references: [id])

  @@unique([roundId, voterId])
  @@index([roundId])
  @@index([voterId])
  @@map("round_votes")
}

model RoundClue {
  id             String   @id @default(cuid())
  roundId        String
  playerId       String
  text           String   @db.VarChar(300)
  flaggedForWord Boolean  @default(false)
  createdAt      DateTime @default(now())

  round Round @relation(fields: [roundId], references: [id])

  @@index([roundId])
  @@map("round_clues")
}

model GameParticipation {
  id              String   @id @default(cuid())
  gameId          String
  userId          String
  role            String   @db.VarChar(20)
  survived        Boolean  @default(false)
  starCoinsEarned Int      @default(0)
  createdAt       DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([gameId, userId])
  @@index([userId])
  @@index([gameId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("game_participations")
}

model WordPack {
  id          String     @id @default(cuid())
  name        String
  description String?
  isPremium   Boolean    @default(false)
  isPublic    Boolean    @default(false)
  isApproved  Boolean    @default(false)
  locale      String     @default("en") @db.VarChar(5)
  authorId    String?
  downloads   Int        @default(0)
  createdAt   DateTime   @default(now())

  pairs WordPair[]

  @@map("word_packs")
}

model WordPair {
  id         String   @id @default(cuid())
  packId     String
  wordA      String
  wordB      String
  difficulty String   @default("medium") @db.VarChar(10)
  category   String   @default("general")
  locale     String   @default("en") @db.VarChar(5)

  pack WordPack @relation(fields: [packId], references: [id])

  @@index([packId, locale, category])
  @@map("word_pairs")
}

model Honor {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  type       String   @db.VarChar(20)
  gameId     String?
  createdAt  DateTime @default(now())

  sender   User @relation("sender",   fields: [senderId],   references: [id])
  receiver User @relation("receiver", fields: [receiverId], references: [id])

  @@index([receiverId])
  @@map("honors")
}

model Achievement {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String
  icon        String
  category    String   @default("general") @db.VarChar(30)  // gameplay, social, ranked, redHanded, detective, milestones, secret
  difficulty  String   @default("bronze") @db.VarChar(15)    // bronze, silver, gold, platinum, diamond, mythic
  xpReward    Int      @default(10)
  coinReward  Int      @default(0)
  isSecret    Boolean  @default(false)
  createdAt   DateTime @default(now())

  users UserAchievement[]

  @@index([category])
  @@index([difficulty])
  @@map("achievements")
}

model UserAchievement {
  id            String    @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime  @default(now())
  claimedAt     DateTime?

  user        User        @relation(fields: [userId],        references: [id])
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
  @@index([userId, claimedAt])
  @@map("user_achievements")
}

model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  status      String   @default("pending") @db.VarChar(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester User @relation("SentRequests",     fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("ReceivedRequests", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId, status])
  @@index([addresseeId, status])
  @@map("friendships")
}

model DirectMessage {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  text       String   @db.VarChar(1000)
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SentDMs",     fields: [senderId],   references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedDMs", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@index([receiverId, createdAt])
  @@map("direct_messages")
}

model GameChatMessage {
  id        String   @id @default(cuid())
  gameId    String
  userId    String
  username  String   @db.VarChar(20)
  text      String   @db.VarChar(500)
  createdAt DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@map("game_chat_messages")
}

// ─── Season Pass ──────────────────────────────────────────────────────────────

model SeasonPass {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isPremium Boolean  @default(false)
  createdAt DateTime @default(now())

  tiers  SeasonTier[]

  @@map("season_passes")
}

model SeasonTier {
  id           String   @id @default(cuid())
  seasonPassId String
  tierNumber   Int
  xpRequired   Int
  rewardType   String   @db.VarChar(20)  // 'starCoins' | 'title'
  rewardValue  String                   // amount or title
  isPremium    Boolean  @default(false)

  seasonPass SeasonPass        @relation(fields: [seasonPassId], references: [id])
  claims     SeasonPassClaim[]

  @@unique([seasonPassId, tierNumber])
  @@map("season_tiers")
}

model SeasonPassClaim {
  id           String   @id @default(cuid())
  userId       String
  seasonTierId String
  claimedAt    DateTime @default(now())

  user       User       @relation(fields: [userId],       references: [id])
  seasonTier SeasonTier @relation(fields: [seasonTierId], references: [id])

  @@unique([userId, seasonTierId])
  @@map("season_pass_claims")
}

// ─── Gifting ──────────────────────────────────────────────────────────────────

model Gift {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  coinAmount  Int      @default(0)
  // When set, this gift delivers a Premium subscription extension. The value
  // matches a PremiumPlan id ('monthly' | 'yearly') from shared constants,
  // and the claim route extends `receiver.premiumUntil` by that plan's
  // interval (monotonically — never shortens existing entitlement).
  premiumPlanId String? @db.VarChar(16)
  message     String?  @db.VarChar(200)
  claimed     Boolean  @default(false)
  createdAt   DateTime @default(now())

  sender   User @relation("GiftSender",   fields: [senderId],   references: [id])
  receiver User @relation("GiftReceiver", fields: [receiverId], references: [id])

  @@map("gifts")
}

// ─── Block & Report ───────────────────────────────────────────────────────────

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@map("blocks")
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  reportedId String
  reason     String   @db.VarChar(50)
  details    String?
  status     String   @default("pending") @db.VarChar(20)
  reporter   User     @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported   User     @relation("reported", fields: [reportedId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([reportedId, status])
  @@map("reports")
}

// ─── Purchases ────────────────────────────────────────────────────────────────

model Purchase {
  id              String   @id @default(cuid())
  userId          String
  packId          String
  starCoins       Int
  priceCents      Int
  currency        String   @default("usd") @db.VarChar(5)
  // Payment platform. "stripe" for web checkout, "apple" for iOS StoreKit /
  // App Store IAP, "google" for Android Play Billing. Drives which verifier
  // ran and which id columns are populated.
  platform        String   @default("stripe") @db.VarChar(16)
  stripeSessionId String?  @unique
  // Platform-specific transaction id for idempotent crediting:
  //   - Apple: originalTransactionId from the signed JWS payload
  //   - Google: purchaseToken returned by Play Billing
  // Unique so a retried verify call for the same receipt can't double-credit.
  platformTxId    String?  @unique
  status          String   @default("pending") @db.VarChar(20) // pending | completed | failed
  // Gift fields. When `giftReceiverId` is set, the payment is made by `userId`
  // but the entitlement is delivered to the receiver through a Gift row on
  // checkout completion. `premiumPlanId` marks one-time premium gifts (not a
  // recurring subscription on the buyer's account) so the webhook knows to
  // create a premium-bearing Gift instead of crediting the buyer.
  giftReceiverId  String?
  premiumPlanId   String?  @db.VarChar(16)
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, platform])
  @@map("purchases")
}
