{
  "cli": {
    "version": ">= 7.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api-staging.redhanded-game.com/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://api-staging.redhanded-game.com",
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID": ""
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.redhanded-game.com/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://api.redhanded-game.com",
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID": ""
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "",
        "ascAppId": "",
        "appleTeamId": ""
      },
      "android": {
        "serviceAccountKeyPath": ""
      }
    }
  }
}
