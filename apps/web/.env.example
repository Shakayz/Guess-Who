# ── Web app environment template ────────────────────────────────────────────
# Copy to .env: cp apps/web/.env.example apps/web/.env
#
# Vite only exposes vars prefixed with VITE_ to the browser. Values are baked
# into the bundle at build time — rebuild after changing them.
# ────────────────────────────────────────────────────────────────────────────

# API base URL (defaults to http://localhost:3001 in dev)
# VITE_API_URL=http://localhost:3001

# Google OAuth (optional — leave empty to disable the Google button)
# Must match GOOGLE_CLIENT_ID in apps/api/.env
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Apple Sign In (optional — leave empty to disable the Apple button)
# This is the Services ID from Apple Developer → Identifiers → Services IDs.
# Must match APPLE_CLIENT_ID in apps/api/.env. The domain serving this app
# must be registered as a "Return URL" in the Services ID config, otherwise
# the popup will fail with invalid_client.
# VITE_APPLE_CLIENT_ID=com.redhanded.game.signin

# Discord OAuth (optional — leave empty to disable the Discord button)
# Client ID from https://discord.com/developers/applications → OAuth2.
# Must match DISCORD_CLIENT_ID in apps/api/.env. The app's origin +
# `/auth/discord/callback` must be registered as a redirect URI in the Discord
# developer portal, otherwise the consent screen returns invalid_redirect_uri.
# VITE_DISCORD_CLIENT_ID=
